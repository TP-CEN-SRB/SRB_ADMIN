generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                 @id @default(uuid())
  profileImageUrl      String?
  email                String                 @unique
  emailVerified        Boolean                @default(false)
  name                 String
  diploma              String?
  faculty              Faculty
  role                 Role
  lat                  Float?
  long                 Float?
  location             String?                @unique
  commandUpdatedAt     DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  treesaved            Int                    @default(0)
  treeprogress         Float                  @default(0.0)
  carbonprint          Float                  @default(0.0)
  image                String?
  sessions             Session[]
  accounts             Account[]
  bins                 Bin[]
  disposals            Disposal[]
  disposal_queue       DisposalQueue[]
  point                Point?
  redemptions          Redemption[]           @relation("RedeemedBy")
  fulfilledRedemptions Redemption[]           @relation("FulfilledRedemptions")
  subscriptions        Subscription[]
  transactions         Transaction[]
  receivedTransfers    TransferSession[]      @relation("ReceivedTransfers")
  sentTransfers        TransferSession[]      @relation("SentTransfers")
  user_quest           UserQuest[]
  user_event           UserEvent[]
  scannerAlertActive   Boolean                @default(false)
  ScannerDiagnosticLog ScannerDiagnosticLog[]
  Feedback             Feedback[]
  FaultReport          FaultReport[]

  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Bin {
  id               String             @id @default(uuid())
  status           BinStatus          @default(FUNCTIONAL)
  currentCapacity  Float              @default(0)
  userId           String
  emailSent        Boolean            @default(false)
  clearCount       Int                @default(0)
  binMaterialId    String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  lastHeartBeat    DateTime?
  binMaterial      BinMaterial        @relation(fields: [binMaterialId], references: [id], onDelete: Cascade)
  user             User               @relation(fields: [userId], references: [id])
  alertLevel       String? // "hardware" | "offline" | "critical" | "full" | null
  disposals        Disposal[]
  BinDiagnosticLog BinDiagnosticLog[]

  @@unique([userId, binMaterialId, status])
  @@map("bins")
}

model BinMaterial {
  id                String @id @default(uuid())
  name              String @unique
  multiplier        Float  @default(1)
  carbon_multiplier Float  @default(1)
  bins              Bin[]

  @@map("bin_materials")
}

model DisposalQueue {
  id        String      @id @default(uuid())
  status    QueueStatus @default(OPEN)
  userId    String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  disposals Disposal[]
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("disposal_queue")
}

model Disposal {
  id            String         @id @default(uuid())
  weightInGrams Int
  binId         String
  isRedeemed    Boolean        @default(false)
  pointsAwarded Int
  userId        String?
  queueId       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  carbonprint   Float          @default(0.0)
  imageUrl      String?
  bin           Bin            @relation(fields: [binId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  queue         DisposalQueue? @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@map("disposals")
}

model Point {
  id        String   @id @default(uuid())
  balance   Int      @default(0)
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("points")
}

model Reward {
  id             String       @id @default(uuid())
  name           String       @unique
  pointsRequired Int
  description    String
  isAvailable    Boolean      @default(true)
  image          String
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  redemptions    Redemption[]

  @@map("rewards")
}

model Redemption {
  id            String           @id @default(uuid())
  userId        String
  rewardId      String
  status        RedemptionStatus @default(PENDING)
  fulfilledAt   DateTime?
  fulfilledById String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  reward        Reward           @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  user          User             @relation("RedeemedBy", fields: [userId], references: [id], onDelete: Cascade)
  fulfilledBy   User?            @relation("FulfilledRedemptions", fields: [fulfilledById], references: [id])

  @@map("redemptions")
}

model Subscription {
  id        String   @id @default(uuid())
  email     String   @unique
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Transaction {
  id              String          @id @default(uuid())
  pointsChange    Int
  description     String
  transactionType TransactionType
  userId          String
  // Set for DISPOSAL transactions - links back to the DisposalQueue whose
  // disposals were redeemed together, so admins can view the trash images.
  // No FK relation since queues aren't guaranteed to outlive their redemption.
  queueId         String?
  // Also DISPOSAL-only: aggregate weight/carbon across the redeemed queue,
  // shown in place of a text description on the member transaction table.
  weightInGrams   Int?
  carbonSaved     Float?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model QuestDetails {
  id           String      @id(map: "quest_pkey") @default(uuid())
  title        String      @db.VarChar(255)
  description  String
  target       Int
  materialType String      @db.VarChar(50)
  startDate    DateTime?   @db.Timestamp(6)
  endDate      DateTime?   @db.Timestamp(6)
  rewardPoints Int         @default(1)
  createdAt    DateTime    @default(now()) @db.Timestamp(6)
  updatedAt    DateTime    @updatedAt @db.Timestamp(6)
  userQuests   UserQuest[]

  @@map("quest_details")
}

model UserQuest {
  id          String       @id @default(uuid())
  progress    Float        @default(0.0)
  isCompleted Boolean      @default(false)
  completedAt DateTime?    @db.Timestamp(6)
  userId      String
  questId     String
  quest       QuestDetails @relation(fields: [questId], references: [id], onDelete: Cascade, map: "userquest_questid_fkey")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade, map: "userquest_userId_fkey")

  @@map("user_quest")
}

model TransferSession {
  id         String    @id @default(uuid())
  senderId   String
  receiverId String?
  amount     Int       @default(0)
  status     String    @default("pending")
  createdAt  DateTime  @default(now()) @map("  createdAt") @db.Timestamp(6)
  redeemedAt DateTime? @db.Timestamp(6)
  receiver   User?     @relation("ReceivedTransfers", fields: [receiverId], references: [id], map: "transfer_session_receiverid_fkey")
  sender     User      @relation("SentTransfers", fields: [senderId], references: [id], onDelete: Cascade, map: "transfer_session_senderid_fkey")

  @@map("transfer_session")
}

model Video {
  id                String   @id @default(uuid())
  name              String
  fileUrl           String
  durationInSeconds Int
  createdAt         DateTime @default(now())

  @@map("video")
}

enum ActivityLogSource {
  APP_ERROR
  BIN_COMMAND
}

model Crashlog {
  id        String            @id @default(uuid())
  message   String
  source    ActivityLogSource @default(APP_ERROR)
  binId     String?
  createdAt DateTime          @default(now())

  @@map("crashlog")
}

model QuestTemplate {
  id           String   @id @default(uuid())
  title        String
  description  String
  target       Int
  rewardPoints Int
  materialType String
  duration     Int      @default(7)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("quest_template")
}

model Event {
  id          String      @id @default(uuid())
  title       String
  description String
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userEvent   UserEvent[]

  @@map("event")
}

model UserEvent {
  id      String @id @default(uuid())
  points  Int    @default(0)
  userId  String
  eventId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade, map: "userevent_userId_fkey")
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade, map: "userevent_eventId_fkey")

  @@map("user_event")
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  category  String
  message   String?
  createdAt DateTime @default(now())

  @@map("feedback")
}

enum FaultStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model FaultReport {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  location      String
  category      String
  type          String
  faultimageUrl String?
  description   String?
  status        FaultStatus @default(OPEN)
  createdAt     DateTime    @default(now())

  // Telegram attribution
  takenByTelegramId      BigInt?
  takenByTelegramName    String?
  resolvedByTelegramId   BigInt?
  resolvedByTelegramName String?

  telegramMessageId BigInt?

  // ✅ NEW: Admin attribution
  takenByAdminId      String?
  takenByAdminName    String?
  resolvedByAdminId   String?
  resolvedByAdminName String?

  @@map("faultreport")
}

model BinDiagnosticLog {
  id        String   @id @default(uuid())
  binId     String
  timestamp DateTime @default(now())

  scannerOK  Boolean
  lidOK      Boolean
  loadcellOK Boolean

  overallStatus BinStatus
  details       Json?

  bin Bin @relation(fields: [binId], references: [id])
}

model ScannerDiagnosticLog {
  id        String   @id @default(uuid())
  userId    String
  timestamp DateTime @default(now())

  scannerOK     Boolean
  overallStatus BinStatus
  details       Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Faculty {
  ENG
  BUS
  ASC
  IIT
  HSS
  DES
  OTHERS
  EXT
}

enum BinStatus {
  FUNCTIONAL
  UNDER_MAINTENANCE
}

enum Role {
  STUDENT
  admin
  BIN
  STAFF
  STORE
}

enum RedemptionStatus {
  PENDING
  FULFILLED
}

enum TransactionType {
  REDEMPTION
  DISPOSAL
  OTHERS
  QUEST_REWARD
  TREE_REWARD
  PURCHASE
}

enum QueueStatus {
  OPEN
  CLOSED
}

model Apikey {
  id                  String    @id
  configId            String    @default("default")
  name                String?
  start               String?
  referenceId         String
  prefix              String?
  key                 String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true)
  rateLimitTimeWindow Int?      @default(86400000)
  rateLimitMax        Int?      @default(10)
  requestCount        Int?      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?

  @@index([configId])
  @@index([referenceId])
  @@index([key])
  @@map("apikey")
}
