//connection string for pgsql 
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Faculty {
  ENGINEERING
  BUSINESS
  SCIENCE
  IT
  DESIGN
}

enum BinStatus {
  FUNCTIONAL
  UNDER_MAINTENANCE
}

enum Role {
  USER
  ADMIN
}

enum BinMaterial {
  PLASTIC
  METAL
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  emailVerified DateTime?
  password      String
  name          String
  faculty       Faculty
  role          Role
  disposals     Disposal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model VerificationToken {
  id      String   @id @default(uuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
  @@map("verification_tokens")
}

model PassswordResetToken {
  id      String   @id @default(uuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
  @@map("password_reset_tokens")
}

model Bin {
  id              String      @id @default(uuid())
  location        String // Outside library
  status          BinStatus
  material        BinMaterial
  currentCapacity Int         @default(0)
  disposals       Disposal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bins")
}

model Disposal {
  id            String   @id @default(uuid())
  weightInGrams Int
  binId         String
  bin           Bin      @relation(fields: [binId], references: [id], onDelete: Cascade)
  isScanned     Boolean
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("disposals")
}
