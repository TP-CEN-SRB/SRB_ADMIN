// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

//connection string for pgsql 
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Faculty {
  ENG
  BUS
  ASC
  IIT
  HSS
  DES
}


enum BinStatus {
  FUNCTIONAL
  UNDER_MAINTENANCE
}

enum Role {
  STUDENT
  ADMIN
  STAFF
  BIN
}

enum TransactionType {
  REDEMPTION
  DISPOSAL
  QUEST_REWARD
  TREE_REWARD
  OTHERS
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  emailVerified    DateTime?
  password         String
  name             String
  faculty          Faculty
  role             Role
  disposals        Disposal[]
  bins             Bin[]
  redemptions      Redemption[]
  subscriptions    Subscription[]
  transactions     Transaction[]
  user_quest       UserQuest[]
  point            Point?
  lat              Decimal?       @db.Decimal(10, 7) // Latitude for bin manager
  long             Decimal?       @db.Decimal(10, 7) // Longitude for bin manager
  location         String?        @unique // Outside library
  commandUpdatedAt DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  treesaved        Int            @default(0)
  treeprogress     Float          @default(0.0)      
  carbonprint      Float          @default(0.0) 

  @@map("users")
}

model VerificationToken {
  id       String   @id @default(uuid())
  email    String
  oldEmail String?
  token    String   @unique
  expires  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, token])
  @@map("verification_tokens")
}

model PassswordResetToken {
  id      String   @id @default(uuid())
  email   String
  token   String   @unique
  expires DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, token])
  @@map("password_reset_tokens")
}

model Bin {
  id              String      @id @default(uuid())
  status          BinStatus   @default(FUNCTIONAL)
  currentCapacity Float       @default(0)
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  emailSent       Boolean     @default(false) // ensure warning email only sends once when threshold is met
  clearCount      Int         @default(0)
  binMaterialId   String
  binMaterial     BinMaterial @relation(fields: [binMaterialId], references: [id], onDelete: Cascade)
  disposals       Disposal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, binMaterialId, status])
  @@map("bins")
}

model BinMaterial {
  id         String @id @default(uuid())
  name       String @unique
  multiplier Float  @default(1)

  bins Bin[]

  @@map("bin_materials")
}

model Disposal {
  id            String   @id @default(uuid())
  weightInGrams Int
  binId         String
  bin           Bin      @relation(fields: [binId], references: [id], onDelete: Cascade)
  isRedeemed    Boolean  @default(false)
  pointsAwarded Int
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  carbonprint   Float    @default(0.0)

  @@map("disposals")
}

model Point {
  id      String @id @default(uuid())
  balance Int    @default(0)
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("points")
}

model Reward {
  id             String  @id @default(uuid())
  name           String  @unique
  pointsRequired Int
  description    String
  isAvailable    Boolean @default(true)
  image          String

  startDate DateTime?
  endDate   DateTime?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  redemptions Redemption[]

  @@map("rewards")
}

model Redemption {
  id       String @id @default(uuid())
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  reward   Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  rewardId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("redemptions")
}

model Subscription {
  id     String @id @default(uuid())
  email  String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

model Transaction {
  id              String          @id @default(uuid())
  pointsChange    Int
  description     String
  transactionType TransactionType
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transactions")
}

model QuestDetails {
  id           String       @id @default(uuid())
  title        String       @db.VarChar(255)
  description  String       @db.Text
  target       Int
  materialType String       @db.VarChar(50)
  startDate    DateTime?
  endDate      DateTime?
  rewardPoints Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  userQuests   UserQuest[]

  @@map("quest_details")
}


model UserQuest {
  id           String        @id @default(uuid())
  progress     Int
  isCompleted  Boolean       @default(false)
  completedAt  DateTime?

  userId       String        
  questId      String

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest        QuestDetails  @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@map("user_quest")
}

