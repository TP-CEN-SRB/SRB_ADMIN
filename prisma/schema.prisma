generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  emailVerified     DateTime?
  password          String
  name              String
  diploma           String?          
  faculty           Faculty
  role              Role
  lat               Decimal?          @db.Decimal(10, 7)
  long              Decimal?          @db.Decimal(10, 7)
  location          String?           @unique
  commandUpdatedAt  DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  treesaved         Int               @default(0)
  treeprogress      Float             @default(0.0)
  carbonprint       Float             @default(0.0)
  bins              Bin[]
  disposals         Disposal[]
  point             Point?
  redemptions       Redemption[]
  subscriptions     Subscription[]
  transactions      Transaction[]
  receivedTransfers TransferSession[] @relation("ReceivedTransfers")
  sentTransfers     TransferSession[] @relation("SentTransfers")
  user_quest        UserQuest[]

  @@map("users")
}

model VerificationToken {
  id        String   @id @default(uuid())
  email     String
  oldEmail  String?
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, token])
  @@map("verification_tokens")
}

model PassswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, token])
  @@map("password_reset_tokens")
}

model Bin {
  id              String      @id @default(uuid())
  status          BinStatus   @default(FUNCTIONAL)
  currentCapacity Float       @default(0)
  userId          String
  emailSent       Boolean     @default(false)
  clearCount      Int         @default(0)
  binMaterialId   String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  lastHeartBeat   DateTime?    
  binMaterial     BinMaterial @relation(fields: [binMaterialId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id])
  disposals       Disposal[]

  @@unique([userId, binMaterialId, status])
  @@map("bins")
}

model BinMaterial {
  id                String @id @default(uuid())
  name              String @unique
  multiplier        Float  @default(1)
  carbon_multiplier Float  @default(1)
  bins              Bin[]

  @@map("bin_materials")
}

model Disposal {
  id            String   @id @default(uuid())
  weightInGrams Int
  binId         String
  isRedeemed    Boolean  @default(false)
  pointsAwarded Int
  userId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  carbonprint   Float    @default(0.0)
  bin           Bin      @relation(fields: [binId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("disposals")
}

model Point {
  id        String   @id @default(uuid())
  balance   Int      @default(0)
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("points")
}

model Reward {
  id             String       @id @default(uuid())
  name           String       @unique
  pointsRequired Int
  description    String
  isAvailable    Boolean      @default(true)
  image          String
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  redemptions    Redemption[]

  @@map("rewards")
}

model Redemption {
  id        String   @id @default(uuid())
  userId    String
  rewardId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reward    Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("redemptions")
}

model Subscription {
  id        String   @id @default(uuid())
  email     String   @unique
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Transaction {
  id              String          @id @default(uuid())
  pointsChange    Int
  description     String
  transactionType TransactionType
  userId          String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model QuestDetails {
  id           String      @id(map: "quest_pkey") @default(uuid())
  title        String      @db.VarChar(255)
  description  String
  target       Int
  materialType String      @db.VarChar(50)
  startDate    DateTime?   @db.Timestamp(6)
  endDate      DateTime?   @db.Timestamp(6)
  rewardPoints Int
  createdAt    DateTime    @default(now()) @db.Timestamp(6)
  updatedAt    DateTime    @updatedAt @db.Timestamp(6)
  userQuests   UserQuest[]

  @@map("quest_details")
}

model UserQuest {
  id          String       @id @default(uuid())
  progress    Float        @default(0.0)
  isCompleted Boolean      @default(false)
  completedAt DateTime?    @db.Timestamp(6)
  userId      String
  questId     String
  quest       QuestDetails @relation(fields: [questId], references: [id], onDelete: Cascade, map: "userquest_questid_fkey")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade, map: "userquest_userId_fkey")

  @@map("user_quest")
}

model TransferSession {
  id         String    @id @default(uuid())
  senderId   String
  receiverId String?
  amount     Int       @default(0)
  status     String    @default("pending")
  createdAt  DateTime  @default(now()) @map("  createdAt") @db.Timestamp(6)
  redeemedAt DateTime? @db.Timestamp(6)
  receiver   User?     @relation("ReceivedTransfers", fields: [receiverId], references: [id], map: "transfer_session_receiverid_fkey")
  sender     User      @relation("SentTransfers", fields: [senderId], references: [id], onDelete: Cascade, map: "transfer_session_senderid_fkey")

  @@map("transfer_session")
}

model Video {
  id                String   @id @default(uuid())
  name              String
  fileUrl           String
  durationInSeconds Int
  createdAt         DateTime @default(now())

  @@map("video")
}

model Crashlog {
  id        String   @id @default(uuid())
  message   String
  createdAt DateTime @default(now())

  @@map("crashlog")
}

model QuestTemplate {
  id           String   @id @default(cuid())
  title        String
  description  String
  target       Int
  rewardPoints Int
  materialType String
  createdAt    DateTime @default(now())
}

enum Faculty {
  ENG
  BUS
  ASC
  IIT
  HSS
  DES
  OTHERS
  EXT
}

enum BinStatus {
  FUNCTIONAL
  UNDER_MAINTENANCE
}

enum Role {
  STUDENT
  ADMIN
  BIN
  STAFF
  STORE
}

enum TransactionType {
  REDEMPTION
  DISPOSAL
  OTHERS
  QUEST_REWARD
  TREE_REWARD
  PURCHASE
}
