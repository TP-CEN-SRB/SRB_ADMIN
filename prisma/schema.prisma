// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

//connection string for pgsql 
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Faculty {
  ENGINEERING
  BUSINESS
  SCIENCE
  IT
  DESIGN
}

enum BinStatus {
  FUNCTIONAL
  UNDER_MAINTENANCE
}

enum Role {
  STUDENT
  ADMIN
  BIN
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  emailVerified DateTime?
  password      String
  name          String
  faculty       Faculty
  role          Role
  disposals     Disposal[]
  bins          Bin[]
  redemptions   Redemption[]
  subscription  Subscription?
  point         Point?
  location      String?  @unique// Outside library

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model VerificationToken {
  id       String   @id @default(uuid())
  email    String
  oldEmail String?
  token    String   @unique
  expires  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, token])
  @@map("verification_tokens")
}

model PassswordResetToken {
  id      String   @id @default(uuid())
  email   String
  token   String   @unique
  expires DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, token])
  @@map("password_reset_tokens")
}

model Bin {
  id              String      @id @default(uuid())
  status          BinStatus   @default(FUNCTIONAL)
  currentCapacity Float       @default(0)
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  emailSent       Boolean     @default(false) // ensure warning email only sends once when threshold is met
  binMaterialId   String
  binMaterial     BinMaterial @relation(fields: [binMaterialId], references: [id], onDelete: Cascade)
  disposals       Disposal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, binMaterialId, status])
  @@map("bins")
}

model BinMaterial {
  id   String @id @default(uuid())
  name String @unique

  bins Bin[]

  @@map("bin_materials")
}

model Disposal {
  id            String   @id @default(uuid())
  weightInGrams Int
  binId         String
  bin           Bin      @relation(fields: [binId], references: [id], onDelete: Cascade)
  isRedeemed    Boolean  @default(false)
  pointsAwarded Int
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("disposals")
}

model Point {
  id      String @id @default(uuid())
  balance Int    @default(0)
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("points")
}

model Reward {
  id             String  @id @default(uuid())
  name           String  @unique
  pointsRequired Int
  description    String
  isAvailable    Boolean @default(true)
  image          String

  startDate DateTime?
  endDate   DateTime?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  redemptions Redemption[]

  @@map("rewards")
}

model Redemption {
  id       String @id @default(uuid())
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  reward   Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  rewardId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("redemptions")
}

model Subscription {
  id           String  @id @default(uuid())
  isSubscribed Boolean @default(true)
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}
